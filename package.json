{
  "name": "asset-organizer",
  "version": "1.0.0",
  "description": "Organize game assets into Fab.com-style categories with preview, undo, and custom taxonomy",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win portable nsis"
  },
  "author": "Mahdi Kareem",
  "license": "MIT",
  "build": {
    "appId": "com.mahdikareem.asset-organizer",
    "productName": "Asset Organizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/trash/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Asset Organizer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.2"
  },
  "dependencies": {
    "trash": "^10.1.1"
  }
}
